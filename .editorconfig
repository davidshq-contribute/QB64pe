# EditorConfig - https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C/C++ files
[*.{c,cpp,h,hpp}]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# QB64 BASIC files
[*.{bas,bi,bm}]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 4

# Batch files (Windows line endings)
[*.{bat,cmd}]
end_of_line = crlf

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
